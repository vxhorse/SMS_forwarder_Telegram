# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environment files
.env
.env.*
!.env.example
venv/
env/
.venv/

# Log files. A log is not always named .log, and this project's logs carry
# message data, so the .txt spelling is named too rather than left to be
# noticed by whoever runs git add -A next.
*.log
*log.txt
logs/

# Docker related
*.tar
*.tar.gz
*.tgz
docker-compose.yml
docker-compose.yaml
# Backups of the local compose file carry the same credentials it does.
docker-compose.yml.bak-*
docker-compose.yaml.bak-*

# System files
.DS_Store

# Editor configuration
.idea/
.vscode/

# Local workflow documents, not in repository
docs/superpowers/
# Named here rather than left to the .gitignore that the tooling writes inside
# its own subdirectory: that file covers the subdirectory it sits in and
# nothing else, so a note written one level up was never actually ignored.
.superpowers/

# Local deployment records name specific hosts
docs/deployments/

# Agent instruction files. They stay on disk - every agent tool reads them from
# the working directory, so ignoring them here changes nothing locally - but
# they describe how this project is worked on rather than what it does, which
# is not what a reader of the published repository came for.
AGENTS.md
CLAUDE.md

# The vendor AT command manual is Quectel's copyrighted material. Keep a local
# copy to work from; doc/AT_COMMANDS.md says where to download it rather than
# this repository redistributing it under its own MIT terms.
doc/*.pdf
