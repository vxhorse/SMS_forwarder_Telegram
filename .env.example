# Every setting the service reads, with its built-in default as the value.
# Copy this file to .env and edit it; anything left out falls back to the same
# default, so a working .env only needs BOT_TOKEN and CHAT_ID.

LOG_LEVEL=INFO

# --- Modem -------------------------------------------------------------------

# Leave SMS_PORT empty to auto-discover the modem's AT command port.
# Set it only if discovery picks the wrong device or the port lives elsewhere.
# With the provided compose file the host device tree is mounted at /hostdev,
# so an explicit port has to be named under that root: /hostdev/ttyUSB2.
SMS_PORT=
SMS_BAUDRATE=115200
# Where to scan for serial devices. Inside the provided compose file this is
# the bind-mounted host /dev; running directly on a host, leave it as /dev.
SMS_DEV_ROOT=/dev
# How long a candidate port gets to answer AT during discovery, in seconds.
PORT_PROBE_TIMEOUT=3.0

# --- Telegram ----------------------------------------------------------------

BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id
# Outbound proxy for the Telegram API. Empty means connect directly.
PROXY_URL=
# Deadline for one outward state notification, in seconds. Clamped to 1-10:
# sending retries internally, and the shutdown path awaits one while the
# container runtime is already counting down to a kill.
NOTIFY_TIMEOUT=5.0

# --- Reconnection ------------------------------------------------------------

# Exponential backoff bounds for reconnecting a component, in seconds.
RECONNECT_BACKOFF_MIN=1.0
RECONNECT_BACKOFF_MAX=30.0
# How long a connected session must last before it counts as a recovery.
# Floored at 5.0: at zero, a component that connects and immediately fails
# would reset the backoff every cycle and never look broken.
SERVICE_STABLE_SECONDS=60.0

# --- Modem liveness probe ----------------------------------------------------

# The probe is also what refreshes the health snapshot, so its interval is
# clamped to half of HEALTH_STALE_SECONDS (and to at least 1.0).
MODEM_PROBE_INTERVAL=30.0
MODEM_PROBE_TIMEOUT=5.0
# Consecutive missed probes that trigger a reconnect.
MODEM_PROBE_FAILURES=3

# --- AT command deadlines, seconds -------------------------------------------

AT_COMMAND_TIMEOUT=3.0
# For commands the modem processes slowly (AT&F, AT+CFUN, AT&W).
AT_SLOW_COMMAND_TIMEOUT=10.0

# --- Health and watchdog -----------------------------------------------------

# Snapshot file the process writes and the container healthcheck reads.
HEALTH_FILE=/tmp/healthy
# How old that snapshot may be before the healthcheck calls it stale.
# Floored at 2, because the probe interval is clamped to half of it.
HEALTH_STALE_SECONDS=120
# Exit the process once any component has been down this long, so the container
# runtime can restart everything as a last resort.
WATCHDOG_DOWN_SECONDS=3600
# How often the watchdog inspects component health. Floored at 1.0.
WATCHDOG_CHECK_INTERVAL=30.0
