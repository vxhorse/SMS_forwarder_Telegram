# Every setting the service reads, with its built-in default as the value.
# Copy this file to .env and edit it; anything left out falls back to the same
# default, so a working .env only needs BOT_TOKEN and CHAT_ID.
#
# One setting is listed commented out rather than with a value, because its
# default is derived from other settings and no fixed number here could stay
# equal to it. It is marked where it appears.

LOG_LEVEL=INFO

# --- Modem -------------------------------------------------------------------

# Leave SMS_PORT empty to auto-discover the modem's AT command port.
# Set it only if discovery picks the wrong device or the port lives elsewhere.
# With the provided compose file the host device tree is mounted at /hostdev,
# so an explicit port has to be named under that root: /hostdev/ttyUSB2.
SMS_PORT=
SMS_BAUDRATE=115200
# Where to scan for serial devices. Inside the provided compose file this is
# the bind-mounted host /dev; running directly on a host, leave it as /dev.
SMS_DEV_ROOT=/dev
# How long a candidate port gets to answer AT during discovery, in seconds.
# Deliberately unbounded: discovery runs before any session exists, and waiting
# for hardware is never something this service cuts short.
PORT_PROBE_TIMEOUT=3.0

# --- Telegram ----------------------------------------------------------------

BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id
# Outbound proxy for the Telegram API. Empty means connect directly.
PROXY_URL=
# Deadline for one outward state notification, in seconds. Floored at 1.0, and
# capped at the ten-second shutdown budget itself, which it shares with
# SERIAL_CLOSE_TIMEOUT below: the device teardown awaits both, one after the
# other, while the container runtime is already counting down to a kill, so
# SERIAL_CLOSE_TIMEOUT is in turn capped by whatever this setting leaves of
# that shared budget.
NOTIFY_TIMEOUT=5.0

# --- Reconnection ------------------------------------------------------------

# Exponential backoff bounds for reconnecting a component, in seconds.
# Floored at 0.1, because the backoff grows by doubling and zero doubles to
# zero: a minimum of zero is not a short first wait but every wait, for ever,
# and the loop would retry a dependency that is not there with nothing in
# between. Deliberately no upper bound: the maximum below is floored at
# whatever this is, so raising it carries the maximum up with it.
RECONNECT_BACKOFF_MIN=1.0
# Floored at RECONNECT_BACKOFF_MIN: a maximum set below the minimum would make
# the backoff shrink on every retry instead of grow. It bounds the base the
# backoff doubles toward, not the wait actually taken: each wait is that base
# scaled by 1 +/- 20% of jitter, which is what keeps two components from
# retrying in lockstep, so the longest wait in practice is a fifth above this
# figure. Deliberately no upper bound: a longer wait only delays a
# reconnection, and WATCHDOG_CHURN_WINDOW's floor grows with it, so the churn
# criterion keeps pace.
RECONNECT_BACKOFF_MAX=30.0
# How long a connected session must last before it counts as a recovery.
# Floored at 5.0: at zero, a component that connects and immediately fails
# would reset the backoff every cycle and never look broken.
#
# Deliberately no upper bound - but not a free setting either: it is held from
# two directions by relationships rather than by a number, and both of them are
# described below.
#
# Nothing is reported up until a session has held this long, so a component is
# marked down from process start until then. This value plus
# WATCHDOG_CHECK_INTERVAL, plus however long the modem takes to connect, has to
# stay under WATCHDOG_DOWN_SECONDS below - otherwise the watchdog exits before
# any component could reach its first recovery, for ever, on working hardware.
# The two terms that can be computed from this file are checked at startup and
# reported; the connect time is the one you have to add yourself.
#
# It is bounded from the other side too. Only a session that lasts this long
# is counted by WATCHDOG_CHURN_SESSIONS below, so a window wider than the
# fastest failure the probe schedule can raise means that failure is left to
# WATCHDOG_DOWN_SECONDS instead. Both ends of that margin are checked at
# startup, and the notice names the figure and which failure it came from.
SERVICE_STABLE_SECONDS=60.0
# How many connected sessions one component may end inside the window below
# before the process exits and the container runtime starts a fresh one.
#
# This is the third watchdog exit, and it catches what the other two cannot. A
# session that lasts SERVICE_STABLE_SECONDS counts as a recovery, and that
# resets the clocks both other criteria measure from - so a failure that takes
# longer than that to raise looks recovered before it fails, and repeats for
# ever with nothing accumulating anywhere. Counting reconnections instead of
# waiting for one to last does not ask what broke, only whether this component
# keeps connecting and disconnecting.
#
# Only sessions that connected and then lasted SERVICE_STABLE_SECONDS are
# counted. A modem that has not enumerated yet fails before every session and
# is waited for indefinitely, exactly as before; a session that ends sooner
# resets neither of the other two clocks, so WATCHDOG_DOWN_SECONDS below goes
# on measuring that failure from the last recovery, and this criterion leaves
# it there.
#
# Known limitation: a component that alternates between the two - several
# failures inside the stable window, then one session that outlasts it - is
# fully measured by neither. The one recovery resets the down clock while
# adding only one to this count, so neither reaches its threshold. How visible
# it is depends on the cycle: the snapshot is written only while every
# component is up, and the healthcheck calls the file stale only once that gap
# passes HEALTH_STALE_SECONDS - so a long down phase flaps the container
# between healthy and unhealthy, while a shorter one leaves it healthy and the
# reconnects counts in the snapshot are the only reading that moves. Nothing
# restarts on either by itself.
#
# One threshold covers both components, so it clears the noisier of the two.
# The modem absorbs its whole not-ready phase before a session starts, so a
# session of its own ends only when something that was working stopped. The
# Telegram loop retries nothing itself - that is the supervisor's job - so
# every transient HTTP error ends a session, and one that had been polling
# longer than the stable window counts here, and a few of those in half an hour
# on a patchy link or proxy mean nothing is actually wrong. Ten sits above that
# while still catching a real loop in about twenty minutes.
#
# Floored at 2: one reconnection is not a pattern, and at zero or one a single
# transient failure would end the process. Deliberately no upper bound: a
# higher threshold only makes the criterion less eager, and the window below
# has a floor multiplied by this count, so it cannot fall behind the count it
# has to hold.
WATCHDOG_CHURN_SESSIONS=10
# The window those sessions are counted in, in seconds.
#
# Unlike WATCHDOG_STALL_SECONDS, this is a fixed number rather than a
# derived one, and at the values this file ships it sits above its own floor -
# so it can be written down here without being reported as an override on
# every start. The floor is derived: it holds WATCHDOG_CHURN_SESSIONS of the
# slowest cycle there is, a full RECONNECT_BACKOFF_MAX plus the longest a
# component can take to raise, which is 1400 seconds at the values here. Below
# that the count could never reach the threshold and the criterion would be
# switched off while looking enabled, so a lower value is raised to the floor
# and reported at startup.
#
# Clearing the floor is a property of these values, not of the number written
# here. Raising RECONNECT_BACKOFF_MAX or WATCHDOG_CHURN_SESSIONS, or slowing
# the probe schedule, raises the floor too - past the 1800 below sooner than
# the gap between the two suggests, and from there this line is reported as an
# override on every start.
#
# MODEM_REGISTRATION_CHECK=1 raises it furthest of all: that check ends a
# session only after MODEM_REGISTRATION_FAILURES readings rather than after
# one, so the slowest cycle is multiplied by that count and the floor here
# becomes 3600 at the values in this file - already above the 1800 written
# below, which is then raised to it and reported.
#
# There is deliberately no upper bound. Widening the window only makes the
# criterion more eager, in proportion to what was asked for; no value of it
# disables a guard or brings back a failure.
WATCHDOG_CHURN_WINDOW=1800.0

# --- Modem liveness probe ----------------------------------------------------

# The probe is also what refreshes the health snapshot, so its interval is
# clamped to half of HEALTH_STALE_SECONDS (and to at least 1.0).
MODEM_PROBE_INTERVAL=30.0
# Capped so the worst gap between two health-snapshot refreshes stays inside
# HEALTH_STALE_SECONDS; how much room that leaves depends on
# MODEM_PROBE_INTERVAL and MODEM_PROBE_FAILURES too. Floored at 1.0.
MODEM_PROBE_TIMEOUT=5.0
# Consecutive missed probes that trigger a reconnect. Floored at 1, so a value
# of zero cannot look like an off switch. Deliberately no upper bound: more
# patience only delays a reconnect, and MODEM_PROBE_TIMEOUT's ceiling tightens
# as this grows.
MODEM_PROBE_FAILURES=3

# --- Modem registration check ------------------------------------------------

# Whether the heartbeat also asks whether the modem is on the network. Off by
# default: the state it reads describes the circuit-switched domain, and a
# network that attaches the modem for packet service alone reports "not
# registered" while every message arrives. Acting on that would end a session
# every few minutes and reinitialise the radio each time.
#
# The state is still parsed, published in the health snapshot and, at
# LOG_LEVEL=DEBUG, logged with this off, so the reading needed to decide is
# available without the check acting on it. Watch the snapshot's registration
# field over a period that includes ordinary message traffic; if it settles on
# 1, 5, 6 or 7 the question has a true answer on your network and this can be
# set to 1.
MODEM_REGISTRATION_CHECK=0
# Consecutive readings of "not on the network" before the session is dropped,
# once the check above is on. Floored at 2: registration dips for a moment
# during a handover, so one reading is evidence of nothing. Deliberately no
# upper bound: more patience only delays the session ending, and while the
# check is on WATCHDOG_CHURN_WINDOW's floor is multiplied by this count, so
# that window keeps pace with the slower cycle it then has to hold.
MODEM_REGISTRATION_FAILURES=3

# --- AT command deadlines, seconds -------------------------------------------

# Deadline for one AT command. Deliberately no upper bound: it bounds a single
# command, not the loop around it, and a command that outlasts the liveness
# probe's own deadline is caught by that probe and the reconnect it forces.
AT_COMMAND_TIMEOUT=3.0
# For commands the modem processes slowly (AT&F, AT+CFUN, AT&W, and the
# stored-message listing AT+CMGL=4). Deliberately no upper bound either: these
# run during setup, which is a wait this service never puts a ceiling on.
AT_SLOW_COMMAND_TIMEOUT=10.0
# How long the serial transport gets to flush what it is still holding when the
# port is released. Past this the transport is aborted, which discards the
# buffer and forces the close through: a modem that has stopped accepting bytes
# never finishes a close on its own, and the process would sit in teardown
# holding the port. Floored at 1.0, so an ordinary disconnect can still flush,
# and capped by whatever NOTIFY_TIMEOUT above leaves of the ten-second shutdown
# budget the two share - both are awaited on the same way out.
SERIAL_CLOSE_TIMEOUT=5.0

# --- Health and watchdog -----------------------------------------------------

# Snapshot file the process writes and the container healthcheck reads.
HEALTH_FILE=/tmp/healthy
# How old that snapshot may be before the healthcheck calls it stale.
# Floored at 2, because the probe interval is clamped to half of it but never
# below 1.0, so a shorter window would be shorter than the fastest refresh
# there can be. Deliberately no upper bound: it is your stated tolerance for a
# stale snapshot, and both probe bounds above are derived from it, so widening
# it loosens them in step.
HEALTH_STALE_SECONDS=120
# Exit the process once any component has been down this long, so the container
# runtime can restart everything as a last resort.
#
# Shortening this is the tempting edit and the dangerous one. Every component
# is down until its first session has lasted SERVICE_STABLE_SECONDS above, so a
# value under that window plus WATCHDOG_CHECK_INTERVAL below plus the modem's
# connect time never lets a working process past its own startup: it exits on
# this timer, restarts, and does it again. A startup notice reports whichever
# part of that sum this file can compute.
#
# Deliberately no upper bound: this setting is itself the ceiling on
# WATCHDOG_STALL_SECONDS below, so widening it only widens what a component
# that has gone silent is tolerated for. Set it under that setting's derived
# floor and the floor wins, which is reported at startup.
WATCHDOG_DOWN_SECONDS=3600
# The second of the three exit paths, and the far shorter one. A component that
# blocks without raising is never marked down, so the setting above never fires
# for it; this one measures how long a component loop has gone without
# reporting that it advanced, and exits on that instead.
#
# It measures component progress only. A health snapshot that cannot be written
# is read separately and reported at ERROR without a restart: every loop is
# demonstrably still advancing, so the write is what failed, and restarting
# cannot make an unwritable path writable.
#
# Left unset deliberately - the only setting in this file without a value.
# Its default is derived (twice HEALTH_STALE_SECONDS) and then raised by a
# floor derived from the probe and polling budgets, which at the defaults here
# puts the figure actually in force near 310 rather than at either number a
# line here could carry. Writing one down would either be overridden and
# reported as an override on every start, or silently drift from the settings
# it is derived from. Set it only to widen the tolerance deliberately: below
# the floor it restarts a process that is merely riding out a slow modem, and
# above WATCHDOG_DOWN_SECONDS it tolerates a silent loss longer than a loud
# one. Either bound moving your value away from it is reported at startup.
# Uncomment this line only together with a number: an empty value is not the
# same as an absent one, and the process refuses to start on one.
#WATCHDOG_STALL_SECONDS=
# How often the watchdog inspects component health. Floored at 1.0, because a
# value of zero would turn this loop into a busy one. Deliberately no upper
# bound: it is a sampling rate, and every threshold is measured from its own
# clock rather than from how often this loop looks, so a slower watchdog delays
# a restart instead of missing one.
WATCHDOG_CHECK_INTERVAL=30.0
